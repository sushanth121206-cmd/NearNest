# ─────────────────────────────────────────────────────────────
# NearNest — environment configuration
# Copy to `.env.local` and fill in your own keys.
# ─────────────────────────────────────────────────────────────

# ── Supabase (PostgreSQL) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: required for service-role writes from API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Firebase Authentication + Cloud Messaging ────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Optional: reCAPTCHA key used for phone OTP
NEXT_PUBLIC_FIREBASE_RECAPTCHA_KEY=

# ── Gemini AI (search, recommendations, multilingual assistant) ─
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# ── Razorpay (UPI, cards, net banking, refunds) ──────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_REFUND_POLICY_URL=https://nearnest.example/refunds

# ── Google Maps Platform (places, distance, navigation) ──────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ── Cloudinary (product & shop image uploads) ────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=nearnest_unsigned
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
